{
  "name": "@hmodding/server",
  "version": "0.0.0",
  "description": "raftmodding database rest api",
  "scripts": {
    "dev": "concurrently \"nodemon\" \"nodemon -x tsoa spec-and-routes\"",
    "build": "tsoa spec-and-routes && npx tsc --build",
    "clean": "npx tsc --clean",
    "start": "node ./dist/server/main.js",
    "format": "npx prettier --write .",
    "migrate": "typeorm migration:run --dataSource ./dist/server/src/db/dataSource.js"
  },
  "author": "raftmodding.com",
  "license": "MIT",
  "dependencies": {
    "@types/json-schema": "^7.0.15",
    "ajv": "^6.10.2",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.0",
    "connect-history-api-fallback": "^2.0.0",
    "core-js": "^3.45.1",
    "cors": "^2.8.5",
    "dayjs": "^1.10.4",
    "dotenv-flow": "^4.1.0",
    "express": "^5.1.0",
    "file-type": "^21.0.0",
    "http-proxy-middleware": "^2.0.6",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.6",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.1.13",
    "regenerator-runtime": "^0.13.7",
    "sequelize": "^6.37.7",
    "tsoa": "^4.1.2",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.18.5",
    "@types/nodemailer": "^7.0.1",
    "@types/validator": "^13.15.3",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "normalize-url": "^8.1.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
